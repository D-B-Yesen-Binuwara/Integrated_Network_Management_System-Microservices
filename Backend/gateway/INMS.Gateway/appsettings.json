{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },

  "AllowedHosts": "localhost;127.0.0.1",
  "Cors": {
    "AllowedOrigins": [],
    "AllowCredentials": false
  },
  "Gateway": {
    "Services": {
      "identity": {
        "RoutePrefix": "/identity"
      },
      "topology": {
        "RoutePrefix": "/topology"
      },
      "alarm": {
        "RoutePrefix": "/alarm"
      }
    }
  }
}
